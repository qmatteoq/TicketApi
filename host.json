{
    "version": "2.0",
    "extensionBundle": {
        "id": "Microsoft.Azure.Functions.ExtensionBundle",
        "version": "[4.29.0, 5.0.0)"
    },
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "mcp": {
            "serverName": "TicketApi MCP Server",
            "serverVersion": "1.0.0",
            "instructions": "This MCP server provides tools for managing support tickets. You can create, delete, and retrieve tickets with various filtering options."
        }
    }
}